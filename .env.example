# Backend API URL (leave empty for production/Vercel, set for local dev)
VITE_API_URL=http://localhost:3001

# Redis URL (only for Vercel/production)
REDIS_URL=redis://default:your_password_here@your-redis-host:port

# Email (Gmail App Password for sending verification codes)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# JWT Secret (change this to a random long string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Local server port
PORT=3001

# Cloudflare Turnstile (anti-bot protection)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
